rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Biodata media: anyone can read public files, anyone can write (no auth required)
    match /biodatas/{slug}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
